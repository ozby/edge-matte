{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-sessionstart-routing\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-sessionstart-routing\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-check-dev-link\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-check-dev-link\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/mcp-first-pretool-guard.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/scripts/mcp-first-pretool-guard.mjs\" || printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"mcp-first-pretool-guard is unavailable. Restore repo hooks or run wp setup.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-post-tool\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-post-tool\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-guard-switch\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-guard-switch\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-stop-qa\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/wp-stop-qa\" || true"
          }
        ]
      }
    ]
  }
}
