#!/bin/sh

# webpresso audit hooks (staged mode — fast)
if [ -f "$(pwd)/scripts/verify-secrets-policy.ts" ]; then
  bun "$(pwd)/scripts/verify-secrets-policy.ts" || exit 1
fi
if [ -f "$(pwd)/scripts/verify-absolute-path-policy.ts" ]; then
  bun "$(pwd)/scripts/verify-absolute-path-policy.ts" || exit 1
fi
if [ -f "$(pwd)/scripts/sync-webpresso-config.ts" ]; then
  bun "$(pwd)/scripts/sync-webpresso-config.ts" --check-only || exit 1
fi
if [ -f "$(pwd)/scripts/audit-secret-provider-quarantine.ts" ]; then
  bun "$(pwd)/scripts/audit-secret-provider-quarantine.ts" || exit 1
fi
