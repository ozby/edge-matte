{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wp-sessionstart-routing >/dev/null 2>&1 && wp-sessionstart-routing || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wp-check-dev-link >/dev/null 2>&1 && wp-check-dev-link || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"/Users/ozby/repos/ozby/edge-matte/scripts/mcp-first-pretool-guard.mjs\" ] && node \"/Users/ozby/repos/ozby/edge-matte/scripts/mcp-first-pretool-guard.mjs\" || printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"mcp-first-pretool-guard is unavailable. Run vp install or wp setup to restore the agent-kit hook surface.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v wp-post-tool >/dev/null 2>&1 && wp-post-tool || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wp-guard-switch >/dev/null 2>&1 && wp-guard-switch || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v wp-stop-qa >/dev/null 2>&1 && wp-stop-qa || true"
          }
        ]
      }
    ]
  }
}
