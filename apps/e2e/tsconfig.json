{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "paths": {
      "#repo-root": ["./src/repo-root.ts"],
      "#fixtures": ["./src/fixtures.ts"],
      "#agent-kit-host-adapter": ["./src/agent-kit-host-adapter.ts"],
      "#ensure-client-dist": ["./src/ensure-client-dist.ts"]
    }
  },
  "include": [
    "../../worker-configuration.d.ts",
    "../worker/node_modules/@cloudflare/workers-types/index.d.ts",
    "src/e2e-suite-manifest.ts",
    "src/e2e-suite-manifest.test.ts",
    "src/agent-kit-host-adapter.ts",
    "src/repo-root.ts",
    "src/fixtures.ts",
    "src/journeys/env.ts",
    "src/cli/**/*.ts",
    "journeys/**/*.ts",
    "journeys/**/*.spec.ts",
    "journeys/**/*.test.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.journeys.config.ts"
  ]
}
