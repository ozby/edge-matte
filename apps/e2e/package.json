{
  "name": "@edge-matte/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#repo-root": "./src/repo-root.ts",
    "#fixtures": "./src/fixtures.ts",
    "#agent-kit-host-adapter": "./src/agent-kit-host-adapter.ts",
    "#ensure-client-dist": "./src/ensure-client-dist.ts"
  },
  "scripts": {
    "pretest": "vp run --filter @edge-matte/client build",
    "test": "vitest run --config vitest.config.ts",
    "test:journeys": "vitest run --config vitest.journeys.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "vp lint src/e2e-suite-manifest.ts src/e2e-suite-manifest.test.ts src/fixtures.ts journeys playwright.config.ts global-setup.ts src/cli/start-local-e2e-server.ts src/repo-root.ts src/ensure-client-dist.ts --tsconfig tsconfig.json --type-aware",
    "e2e:run": "bun src/cli/run-e2e.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
