{
  "name": "edge-matte",
  "version": "0.1.1",
  "private": true,
  "description": "Cloudflare-native image matting reference app for upload, background removal, edge flip, R2 hosting, and capability-token deletion.",
  "keywords": [
    "background-removal",
    "cloudflare-workers",
    "hono",
    "image-processing",
    "r2",
    "typescript",
    "vite-plus",
    "webpresso",
    "workers-images"
  ],
  "homepage": "https://edge-matte.ozby.dev",
  "bugs": {
    "url": "https://github.com/ozby/edge-matte/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozby/edge-matte.git"
  },
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "setup:agent": "wp setup",
    "build": "vp run -r build",
    "catalog:check": "wp audit catalog-drift",
    "check": "vp check",
    "check-types": "vp run -r check-types",
    "typecheck": "wp typecheck",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp run -r lint",
    "test": "node --test \"test/**/*.test.mjs\" && vp run -r test",
    "e2e": "bun ./apps/e2e/src/cli/run-e2e.ts",
    "act:ci:e2e": "with-secrets -- act -W .github/workflows/ci.webpresso.yml -j e2e",
    "deploy:preview": "bun scripts/deploy-preview.ts",
    "deploy:production": "bun scripts/deploy-production.ts",
    "deploy:production:wrangler": "with-secrets -- vp exec --filter @edge-matte/worker -- wrangler deploy --env production",
    "verify:deploy-contract": "bun scripts/verify-deploy-contract.ts",
    "pulumi:preview": "with-secrets -- vp exec --filter @edge-matte/infra -- pulumi preview",
    "pulumi:up": "with-secrets -- vp exec --filter @edge-matte/infra -- pulumi up",
    "setup:secrets": "bun scripts/sync-webpresso-config.ts --force",
    "verify:paths": "wp audit absolute-path-policy --root .",
    "verify:secrets": "bun scripts/verify-secrets-policy.ts && bun scripts/sync-webpresso-config.ts --check-only",
    "audit:secret-provider-quarantine": "bun scripts/audit-secret-provider-quarantine.ts",
    "audit:blueprint-links": "bun scripts/audit-blueprint-link-policy.ts",
    "docs:check": "wp audit docs-frontmatter",
    "blueprints:check": "wp audit blueprint-lifecycle --legacy-omx",
    "prepare": "husky && bun scripts/sync-webpresso-config.ts",
    "mutation": "wp test --mutation",
    "test:mutation": "stryker run stryker.config.ts",
    "qa": "wp lint src e2e *.config.ts && wp typecheck && wp test --file vitest.config.ts && wp test --mutation && wp e2e --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "^24.3.0",
    "@webpresso/agent-kit": "catalog:",
    "husky": "^9.0.0",
    "oxlint": "^1.36.0",
    "typescript": "catalog:",
    "vite-plus": "^0.1.22",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild@0.27.0",
      "esbuild@0.27.3",
      "esbuild@0.27.7",
      "sharp@0.33.5",
      "sharp@0.34.5",
      "workerd@1.20251210.0",
      "workerd@1.20260521.1"
    ]
  }
}