{
  "name": "edge-matte",
  "version": "0.1.1",
  "private": true,
  "description": "Cloudflare-native image matting reference app for upload, background removal, edge flip, R2 hosting, and capability-token deletion.",
  "keywords": [
    "background-removal",
    "cloudflare-workers",
    "hono",
    "image-processing",
    "r2",
    "typescript",
    "vite-plus",
    "webpresso",
    "workers-images"
  ],
  "homepage": "https://edge-matte.ozby.dev",
  "bugs": {
    "url": "https://github.com/ozby/edge-matte/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozby/edge-matte.git"
  },
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*",
    "#infra-deploy/*": "./infra/src/deploy/*.ts"
  },
  "scripts": {
    "setup:agent": "wp setup",
    "postinstall": "test -n \"$CI\" || wp setup",
    "build": "vp run --filter @edge-matte/client build && vp run --filter @edge-matte/worker build",
    "catalog:check": "wp audit catalog-drift",
    "check": "vp check",
    "check-types": "vp run --filter @edge-matte/client check-types && vp run --filter @edge-matte/e2e check-types && vp run --filter @edge-matte/worker check-types && vp run --filter @edge-matte/infra check-types && pnpm exec tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm run check-types",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "wp lint",
    "test": "vp run --filter @edge-matte/client test && vp run --filter @edge-matte/e2e test && vp run --filter @edge-matte/worker test && vp run --filter @edge-matte/infra test && node --test \"test/**/*.test.ts\"",
    "e2e": "wp e2e",
    "act:ci:e2e": "with-secrets -- act -W .github/workflows/ci.yml -j e2e",
    "deploy:preview": "wp deploy --lane preview_main",
    "deploy:production": "wp deploy --lane prd",
    "verify:deploy-contract": "bun infra/src/deploy/verify-deploy-contract.ts",
    "pulumi:preview": "with-secrets -- vp exec --filter @edge-matte/infra -- pulumi preview",
    "pulumi:up": "with-secrets -- vp exec --filter @edge-matte/infra -- pulumi up",
    "setup:secrets": "bun scripts/sync-webpresso-config.ts --force",
    "verify:paths": "wp audit absolute-path-policy --root .",
    "verify:secrets": "WP_SKIP_UPDATE_CHECK=1 wp audit secrets-policy && WP_SKIP_UPDATE_CHECK=1 wp audit secrets-config",
    "audit:secret-provider-quarantine": "WP_SKIP_UPDATE_CHECK=1 wp audit secret-provider-quarantine",
    "audit:blueprint-links": "bun scripts/audit-blueprint-link-policy.ts",
    "docs:check": "wp audit docs-frontmatter",
    "blueprints:check": "wp audit blueprint-lifecycle",
    "prepare": "husky && bun scripts/sync-webpresso-config.ts",
    "mutation": "wp test --mutation",
    "test:mutation": "wp test --mutation",
    "qa": "wp lint && pnpm run typecheck && pnpm run test && wp test --mutation && wp e2e",
    "deploy:dry-run": "wp deploy --lane prd --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "^24.3.0",
    "@webpresso/agent-kit": "catalog:",
    "husky": "^9.0.0",
    "secretlint": "^9.3.0",
    "typescript": "catalog:",
    "vite-plus": "^0.1.24",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild@0.27.0",
      "esbuild@0.27.3",
      "esbuild@0.27.7",
      "sharp@0.33.5",
      "sharp@0.34.5",
      "workerd@1.20251210.0",
      "workerd@1.20260521.1"
    ]
  }
}