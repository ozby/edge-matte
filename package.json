{
  "name": "edge-matte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "setup:agent": "wp setup",
    "build": "vp run -r build",
    "check": "vp check",
    "check-types": "vp run -r check-types",
    "typecheck": "vp run -r check-types",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp run -r lint",
    "test": "node --test \"test/**/*.test.mjs\" && vp run -r test",
    "e2e": "bun ./apps/e2e/src/cli/run-e2e.ts",
    "deploy:production": "bun scripts/deploy-production.ts",
    "deploy:production:wrangler": "with-secrets -- pnpm --filter @edge-matte/worker exec wrangler deploy --env production",
    "pulumi:preview": "with-secrets -- pnpm --filter @edge-matte/infra exec pulumi preview",
    "pulumi:up": "with-secrets -- pnpm --filter @edge-matte/infra exec pulumi up",
    "setup:secrets": "bun scripts/sync-webpresso-config.ts --force",
    "verify:paths": "bun scripts/verify-absolute-path-policy.ts",
    "verify:secrets": "bun scripts/verify-secrets-policy.ts && bun scripts/sync-webpresso-config.ts --check-only",
    "audit:secret-provider-quarantine": "bun scripts/audit-secret-provider-quarantine.ts",
    "docs:check": "WP_SKIP_UPDATE_CHECK=1 wp audit docs-frontmatter",
    "blueprints:check": "WP_SKIP_UPDATE_CHECK=1 wp audit blueprint-lifecycle --legacy-omx",
    "prepare": "husky && bun scripts/sync-webpresso-config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "husky": "^9.0.0",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.22"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild@0.27.0",
      "esbuild@0.27.3",
      "esbuild@0.27.7",
      "sharp@0.33.5",
      "sharp@0.34.5",
      "workerd@1.20251210.0",
      "workerd@1.20260521.1"
    ]
  }
}
