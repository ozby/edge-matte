{
  "version": "1",
  "installed": {
    "tier3Skills": ["base-kit"]
  },
  "hosts": {
    "selected": ["codex", "claude", "opencode"],
    "requiredCapabilities": ["verify", "plan-refine"],
    "visibility": {
      "codex": {
        "verify": "visible-after-restart",
        "plan-refine": "visible-after-restart"
      },
      "claude": {
        "verify": "visible-after-restart",
        "plan-refine": "visible-after-restart"
      },
      "opencode": {
        "verify": "visible-after-restart",
        "plan-refine": "visible-after-restart"
      }
    }
  },
  "guard": {
    "packageManager": "vp-only",
    "scriptRoutes": {
      "verify:paths": "absolute-path-policy",
      "docs:check": "docs-frontmatter",
      "blueprints:check": "blueprint-lifecycle"
    }
  },
  "audit": {
    "toolchainIsolation": {
      "allowDependencies": [
        "@playwright/test",
        "@stryker-mutator/core",
        "@stryker-mutator/typescript-checker",
        "@stryker-mutator/vitest-runner",
        "oxlint",
        "tsx",
        "typescript",
        "vite",
        "vitest",
        "wrangler"
      ]
    }
  },
  "rules": {
    "overrides": []
  },
  "scripts": {},
  "durablePlanningRoot": ".agent/planning/",
  "globalInstall": true
}