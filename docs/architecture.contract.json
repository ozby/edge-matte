{
  "version": 1,
  "architectureDocs": [
    "docs/architecture.md"
  ],
  "requiredFiles": [
    "blueprints/completed/2026-05-27-edge-matte.md"
  ],
  "rules": [
    {
      "id": "production-domain",
      "paths": [
        "docs/architecture.md",
        "blueprints/**/*.md",
        "README.md"
      ],
      "mustContain": [
        "edge-matte.ozby.dev"
      ]
    },
    {
      "id": "agent-kit-quality-reuse",
      "paths": [
        "docs/architecture.md",
        "blueprints/**/*.md"
      ],
      "mustContain": [
        "agent-kit",
        "vite-plus"
      ]
    }
  ],
  "blueprintPolicy": {
    "enabled": true,
    "blueprintGlobs": [
      "blueprints/**/*.md"
    ],
    "architectureDocGlobs": [
      "docs/architecture.md"
    ],
    "requireArchitectureLinks": true,
    "requireBeforeAfterWhenArchitectureChanging": true,
    "architectureChangeMarkers": [
      "architecture",
      "deployment",
      "route",
      "r2",
      "queue",
      "adapter",
      "port",
      "state machine",
      "cloudflare"
    ],
    "beforeHeading": "Architecture before",
    "afterHeading": "Architecture after",
    "exemptStatuses": [
      "completed",
      "archived"
    ]
  }
}
