{
  "version": 1,
  "architectureDocs": ["docs/architecture.md"],
  "requiredFiles": ["blueprints/completed/2026-05-27-edge-matte.md"],
  "publicRoutes": [
    "POST /api/jobs",
    "GET /api/jobs/:id",
    "GET /r/:id",
    "GET /i/:id",
    "GET /i/:id/original",
    "DELETE /api/jobs/:id",
    "GET /health"
  ],
  "deployLanes": {
    "preview_main": "edge-matte-preview-main on preview-main.edge-matte.ozby.dev",
    "preview_pr": "edge-matte-preview-pr-<n> on preview-pr-<n>.edge-matte.ozby.dev",
    "prd": "edge-matte env.production on edge-matte.ozby.dev"
  },
  "rules": [
    {
      "id": "production-domain",
      "paths": ["docs/architecture.md", "blueprints/**/*.md", "README.md"],
      "mustContain": ["edge-matte.ozby.dev"]
    },
    {
      "id": "agent-kit-quality-reuse",
      "paths": ["docs/architecture.md", "blueprints/**/*.md"],
      "mustContain": ["agent-kit", "vite-plus"]
    }
  ],
  "blueprintPolicy": {
    "enabled": true,
    "blueprintGlobs": ["blueprints/**/*.md"],
    "architectureDocGlobs": ["docs/architecture.md"],
    "requireArchitectureLinks": true,
    "requireBeforeAfterWhenArchitectureChanging": true,
    "architectureChangeMarkers": [
      "architecture",
      "deployment",
      "route",
      "r2",
      "queue",
      "adapter",
      "port",
      "state machine",
      "cloudflare"
    ],
    "beforeHeading": "Architecture before",
    "afterHeading": "Architecture after",
    "exemptStatuses": ["completed", "archived"]
  }
}