{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "agent-kit.config.ts",
    "commitlint.config.ts",
    "playwright.config.ts",
    "stryker.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "webpresso.config.ts",
    "apps/workers/worker-configuration.d.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".agent", ".agents", ".claude", ".husky", "coverage", ".git"]
}